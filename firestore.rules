rules_version = '2';

// כללי האבטחה של Firestore. מועלים עם: firebase deploy --only firestore:rules
//
// מבנה:
//   files/{fileId}            פרטי קובץ, וחתיכות התוכן ב-files/{fileId}/chunks/{n}
//   codes/{code}              קוד אישי של קובץ: { fileId, singleUse, ttlMinutes, used, createdAt, ... }
//                             או קוד המאסטר: { master: true }
//   queue/{fileId}            קובץ שהקוד החד-פעמי שלו עוד לא נוצל: { code, ttlMinutes, createdAt }
//   access/{fileId}_{uid}     הרשאת הורדה ל-10 דקות, נוצרת יחד עם מימוש הקוד
//   claims/{uid}              הוכחה שהמשתמש הזין את קוד המאסטר (ל-10 דקות)
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && request.auth.token.email == 'rb077858@gmail.com'
        && request.auth.token.email_verified == true;
    }

    // ttlMinutes == 0 פירושו "לא פג לעולם"
    function alive(c) {
      return c.ttlMinutes == 0
        || request.time < c.createdAt + duration.value(c.ttlMinutes, 'm');
    }

    // הקוד סומן כמשומש בדיוק בכתיבה הזו, על ידי המשתמש הזה
    function usedNow(c) {
      return c.singleUse == true && c.used == true
        && c.usedBy == request.auth.uid && c.usedAt == request.time;
    }

    function hasAccess(fileId) {
      let p = /databases/$(database)/documents/access/$(fileId + '_' + request.auth.uid);
      return signedIn() && exists(p) && request.time < get(p).data.at + duration.value(10, 'm');
    }

    function isMasterHolder() {
      let p = /databases/$(database)/documents/claims/$(request.auth.uid);
      return signedIn() && exists(p)
        && request.time < get(p).data.at + duration.value(10, 'm')
        && get(/databases/$(database)/documents/codes/$(get(p).data.code)).data.get('master', false) == true;
    }

    match /files/{fileId} {
      allow read: if isAdmin() || hasAccess(fileId);
      // העלאה מדף /send (משתמש אנונימי)
      allow create: if isAdmin() || (signedIn()
        && request.resource.data.keys().hasOnly(['name', 'type', 'size', 'chunks', 'owner', 'createdAt', 'source'])
        && request.resource.data.owner == request.auth.uid
        && request.resource.data.source == 'send'
        && request.resource.data.createdAt == request.time
        && request.resource.data.size is int
        && request.resource.data.size <= 15 * 1024 * 1024
        && request.resource.data.chunks is int
        && request.resource.data.chunks >= 1
        && request.resource.data.chunks <= 25);
      allow update, delete: if isAdmin();

      match /chunks/{n} {
        allow read: if isAdmin() || hasAccess(fileId);
        allow create: if isAdmin() || (signedIn()
          && get(/databases/$(database)/documents/files/$(fileId)).data.owner == request.auth.uid
          && int(n) < get(/databases/$(database)/documents/files/$(fileId)).data.chunks
          && request.resource.data.keys().hasOnly(['d'])
          && request.resource.data.d is bytes
          && request.resource.data.d.size() <= 800000);
        allow update, delete: if isAdmin();
      }
    }

    match /codes/{code} {
      // אפשר לבדוק קוד מסוים, אבל רק המנהל רואה את רשימת כל הקודים
      allow get: if signedIn();
      allow list: if isAdmin();

      // קוד שנוצר מדף /send: 6 ספרות, חד-פעמי, שעתיים, לקובץ שהמשתמש עצמו העלה
      allow create: if isAdmin() || (signedIn()
        && code.matches('^[0-9]{6}$')
        && request.resource.data.keys().hasOnly(['fileId', 'singleUse', 'ttlMinutes', 'used', 'createdAt', 'createdBy'])
        && request.resource.data.singleUse == true
        && request.resource.data.used == false
        && request.resource.data.ttlMinutes == 120
        && request.resource.data.createdAt == request.time
        && request.resource.data.createdBy == request.auth.uid
        && get(/databases/$(database)/documents/files/$(request.resource.data.fileId)).data.owner == request.auth.uid);

      // מימוש קוד חד-פעמי: רק סימון כמשומש, ורק אם עדיין לא נוצל ובתוקף
      allow update: if isAdmin() || (signedIn()
        && resource.data.get('master', false) == false
        && resource.data.singleUse == true
        && resource.data.used == false
        && alive(resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['used', 'usedBy', 'usedAt'])
        && request.resource.data.used == true
        && request.resource.data.usedBy == request.auth.uid
        && request.resource.data.usedAt == request.time);

      allow delete: if isAdmin();
    }

    match /queue/{fileId} {
      // רק המנהל ומי שהזין את קוד המאסטר רואים את התור (הוא כולל את הקודים)
      allow read: if isAdmin() || isMasterHolder();
      // נוצר מדף /send יחד עם הקוד
      allow create: if isAdmin() || (signedIn()
        && request.resource.data.keys().hasOnly(['code', 'ttlMinutes', 'createdAt'])
        && request.resource.data.ttlMinutes == 120
        && request.resource.data.createdAt == request.time
        && getAfter(/databases/$(database)/documents/codes/$(request.resource.data.code)).data.fileId == fileId
        && getAfter(/databases/$(database)/documents/codes/$(request.resource.data.code)).data.createdBy == request.auth.uid);
      // יוצא מהתור כשהקוד שלו מומש
      allow delete: if isAdmin() || (signedIn() && (resource == null
        || usedNow(getAfter(/databases/$(database)/documents/codes/$(resource.data.code)).data)));
      allow update: if isAdmin();
    }

    function validAccess(fileId, d) {
      let c = getAfter(/databases/$(database)/documents/codes/$(d.code)).data;
      return c.get('master', false) == false
        && c.fileId == fileId
        && (usedNow(c) || (c.singleUse == false && alive(c)));
    }

    match /access/{id} {
      allow create, update: if signedIn()
        && request.resource.data.keys().hasOnly(['fileId', 'code', 'at'])
        && request.resource.data.fileId is string
        && request.resource.data.code is string
        && id == request.resource.data.fileId + '_' + request.auth.uid
        && request.resource.data.at == request.time
        && validAccess(request.resource.data.fileId, request.resource.data);
      allow read, delete: if isAdmin();
    }

    match /claims/{uid} {
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['code', 'at'])
        && request.resource.data.code is string
        && request.resource.data.at == request.time
        && get(/databases/$(database)/documents/codes/$(request.resource.data.code)).data.get('master', false) == true;
      allow read, delete: if isAdmin();
    }
  }
}
