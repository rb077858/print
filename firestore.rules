rules_version = '2';

// כללי האבטחה של Firestore. מועלים עם: firebase deploy --only firestore:rules
//
// מבנה:
//   users/{email}             משתמש: { name, approved, blocked, activeUntil, personalCode, ... }
//   files/{fileId}            קובץ בתור של משתמש: { name, ownerEmail, inQueue, code, ... }
//                             והתוכן בחתיכות: files/{fileId}/chunks/{n}
//   codes/{code}              kind: 'file'     קוד של קובץ { fileId, ownerEmail, singleUse, ttlMinutes, used, createdAt }
//                             kind: 'personal' קוד אישי של משתמש { email }
//                             kind: 'master'   קוד המאסטר של המנהל
//   claims/{uid}              מי שהזין קוד אישי / מאסטר: { code, email ('*' למאסטר), at } ל-30 דקות
//   access/{fileId}_{uid}     הרשאת הורדה ל-10 דקות אחרי מימוש קוד של קובץ
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function myEmail() {
      return request.auth.token.email;
    }

    function isAdmin() {
      return signedIn()
        && request.auth.token.email == 'rb077858@gmail.com'
        && request.auth.token.email_verified == true;
    }

    function google() {
      return signedIn()
        && request.auth.token.firebase.sign_in_provider == 'google.com'
        && request.auth.token.email_verified == true;
    }

    function activeUser(u) {
      return u.approved == true && u.blocked == false
        && (u.activeUntil == null || request.time < u.activeUntil);
    }

    // משתמש מחובר שמורשה להשתמש באתר (או המנהל)
    function canSend() {
      return isAdmin() || (google()
        && exists(/databases/$(database)/documents/users/$(myEmail()))
        && activeUser(get(/databases/$(database)/documents/users/$(myEmail())).data));
    }

    // ttlMinutes == 0 פירושו "לא פג לעולם"
    function alive(c) {
      return c.ttlMinutes == 0
        || request.time < c.createdAt + duration.value(c.ttlMinutes, 'm');
    }

    // קוד של קובץ שעדיין אפשר להשתמש בו
    function codeActive(c) {
      return c.used == false && alive(c);
    }

    // הקוד סומן כמשומש בדיוק בכתיבה הזו, על ידי המשתמש הזה
    function usedNow(c) {
      return c.singleUse == true && c.used == true
        && c.usedBy == request.auth.uid && c.usedAt == request.time;
    }

    // מי שהזין קוד אישי של email (או את קוד המאסטר) ב-30 הדקות האחרונות
    function holderOf(email) {
      let p = /databases/$(database)/documents/claims/$(request.auth.uid);
      return signedIn() && exists(p)
        && request.time < get(p).data.at + duration.value(30, 'm')
        && (get(p).data.email == email || get(p).data.email == '*');
    }

    function hasAccess(fileId) {
      let p = /databases/$(database)/documents/access/$(fileId + '_' + request.auth.uid);
      return signedIn() && exists(p) && request.time < get(p).data.at + duration.value(10, 'm');
    }

    function ownsFile(f) {
      return canSend() && f.ownerEmail == myEmail();
    }

    match /files/{fileId} {
      allow read: if isAdmin()
        || (signedIn() && resource.data.ownerEmail == myEmail() && canSend())
        || holderOf(resource.data.ownerEmail)
        || hasAccess(fileId);

      // העלאה לתור של המשתמש
      allow create: if isAdmin() || (canSend()
        && request.resource.data.keys().hasOnly(['name', 'type', 'size', 'chunks', 'owner', 'ownerEmail', 'createdAt', 'source', 'inQueue', 'code'])
        && request.resource.data.owner == request.auth.uid
        && request.resource.data.ownerEmail == myEmail()
        && request.resource.data.createdAt == request.time
        && request.resource.data.inQueue == true
        && request.resource.data.code == null
        && request.resource.data.name is string
        && request.resource.data.size is int
        && request.resource.data.size <= 15 * 1024 * 1024
        && request.resource.data.chunks is int
        && request.resource.data.chunks >= 1
        && request.resource.data.chunks <= 25);

      allow update: if isAdmin()
        // הבעלים משנה את שם הקובץ
        || (ownsFile(resource.data)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name'])
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 200)
        // הבעלים מצמיד לקובץ קוד חדש: רק אם אין לו קוד בתוקף (אי אפשר "לאפס" קוד פעיל)
        || (ownsFile(resource.data)
          && (resource.data.code == null
            || !exists(/databases/$(database)/documents/codes/$(resource.data.code))
            || !codeActive(get(/databases/$(database)/documents/codes/$(resource.data.code)).data))
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['code'])
          && getAfter(/databases/$(database)/documents/codes/$(request.resource.data.code)).data.kind == 'file'
          && getAfter(/databases/$(database)/documents/codes/$(request.resource.data.code)).data.fileId == fileId)
        // הדפסה: הקובץ יוצא מהתור. מותר למי שמחזיק בקוד האישי / מאסטר,
        // או למי שמימש עכשיו את הקוד של הקובץ
        || (signedIn()
          && resource.data.inQueue == true
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['inQueue', 'printedAt', 'printedBy'])
          && request.resource.data.inQueue == false
          && request.resource.data.printedAt == request.time
          && request.resource.data.printedBy == request.auth.uid
          && (holderOf(resource.data.ownerEmail)
            || (resource.data.code != null
              && usedNow(getAfter(/databases/$(database)/documents/codes/$(resource.data.code)).data))));

      allow delete: if isAdmin() || ownsFile(resource.data);

      match /chunks/{n} {
        allow read: if isAdmin()
          || hasAccess(fileId)
          || holderOf(get(/databases/$(database)/documents/files/$(fileId)).data.ownerEmail)
          || ownsFile(get(/databases/$(database)/documents/files/$(fileId)).data);
        allow create: if isAdmin() || (canSend()
          && get(/databases/$(database)/documents/files/$(fileId)).data.owner == request.auth.uid
          && int(n) < get(/databases/$(database)/documents/files/$(fileId)).data.chunks
          && request.resource.data.keys().hasOnly(['d'])
          && request.resource.data.d is bytes
          && request.resource.data.d.size() <= 800000);
        allow delete: if isAdmin() || ownsFile(get(/databases/$(database)/documents/files/$(fileId)).data);
        allow update: if isAdmin();
      }
    }

    match /codes/{code} {
      // אפשר לבדוק קוד מסוים, אבל רק המנהל רואה את רשימת כל הקודים
      allow get: if signedIn();
      allow list: if isAdmin();

      allow create: if isAdmin()
        // קוד לקובץ: 6 ספרות, חד-פעמי, 24 שעות, לקובץ של המשתמש עצמו
        || (canSend()
          && code.matches('^[0-9]{6}$')
          && request.resource.data.keys().hasOnly(['kind', 'fileId', 'ownerEmail', 'singleUse', 'ttlMinutes', 'used', 'createdAt', 'createdBy'])
          && request.resource.data.kind == 'file'
          && request.resource.data.singleUse == true
          && request.resource.data.used == false
          && request.resource.data.ttlMinutes == 1440
          && request.resource.data.createdAt == request.time
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.ownerEmail == myEmail()
          && get(/databases/$(database)/documents/files/$(request.resource.data.fileId)).data.ownerEmail == myEmail())
        // קוד אישי חדש של המשתמש עצמו
        || (canSend()
          && code.matches('^[0-9]{6}$')
          && request.resource.data.keys().hasOnly(['kind', 'email', 'createdAt'])
          && request.resource.data.kind == 'personal'
          && request.resource.data.email == myEmail()
          && request.resource.data.createdAt == request.time);

      // מימוש קוד של קובץ: רק סימון כמשומש, ורק אם עדיין לא נוצל ובתוקף
      allow update: if isAdmin() || (signedIn()
        && resource.data.kind == 'file'
        && resource.data.singleUse == true
        && resource.data.used == false
        && alive(resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['used', 'usedBy', 'usedAt'])
        && request.resource.data.used == true
        && request.resource.data.usedBy == request.auth.uid
        && request.resource.data.usedAt == request.time);

      // המשתמש מוחק את הקוד האישי הישן שלו, או קוד של קובץ שלו:
      // יחד עם מחיקת הקובץ, או קוד שכבר לא בתוקף
      allow delete: if isAdmin() || (canSend()
        && ((resource.data.kind == 'personal' && resource.data.email == myEmail())
          || (resource.data.kind == 'file' && resource.data.ownerEmail == myEmail()
            && (!existsAfter(/databases/$(database)/documents/files/$(resource.data.fileId))
              || !codeActive(resource.data)))));
    }

    match /access/{id} {
      allow create, update: if signedIn()
        && request.resource.data.keys().hasOnly(['fileId', 'code', 'at'])
        && request.resource.data.fileId is string
        && request.resource.data.code is string
        && id == request.resource.data.fileId + '_' + request.auth.uid
        && request.resource.data.at == request.time
        && getAfter(/databases/$(database)/documents/codes/$(request.resource.data.code)).data.kind == 'file'
        && getAfter(/databases/$(database)/documents/codes/$(request.resource.data.code)).data.fileId == request.resource.data.fileId
        && (usedNow(getAfter(/databases/$(database)/documents/codes/$(request.resource.data.code)).data)
          || (getAfter(/databases/$(database)/documents/codes/$(request.resource.data.code)).data.singleUse == false
            && alive(getAfter(/databases/$(database)/documents/codes/$(request.resource.data.code)).data)));
      allow read, delete: if isAdmin();
    }

    match /claims/{uid} {
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['code', 'email', 'at'])
        && request.resource.data.code is string
        && request.resource.data.email is string
        && request.resource.data.at == request.time
        && validClaim(request.resource.data);
      allow read, delete: if isAdmin();
    }

    function validClaim(d) {
      let c = get(/databases/$(database)/documents/codes/$(d.code)).data;
      return (c.kind == 'master' && d.email == '*')
        || (c.kind == 'personal' && c.email == d.email && personalOk(d.email, d.code));
    }

    function personalOk(email, code) {
      let u = get(/databases/$(database)/documents/users/$(email)).data;
      return u.get('personalCode', '') == code && activeUser(u);
    }

    match /users/{email} {
      allow get: if isAdmin() || (signedIn() && myEmail() == email);
      // מי שהזין את קוד המאסטר רואה את רשימת המשתמשים
      allow list: if isAdmin() || holderOf('*');
      // משתמש חדש מבקש גישה; רק המנהל יכול לאשר
      allow create: if isAdmin() || (google()
        && myEmail() == email
        && request.resource.data.keys().hasOnly(['name', 'requestedAt', 'approved', 'blocked', 'activeUntil'])
        && request.resource.data.approved == false
        && request.resource.data.blocked == false
        && request.resource.data.activeUntil == null
        && request.resource.data.requestedAt == request.time);
      // המשתמש מחליף את הקוד האישי שלו (לקוד אישי חדש שהוא יצר)
      allow update: if isAdmin() || (canSend()
        && myEmail() == email
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['personalCode'])
        && getAfter(/databases/$(database)/documents/codes/$(request.resource.data.personalCode)).data.kind == 'personal'
        && getAfter(/databases/$(database)/documents/codes/$(request.resource.data.personalCode)).data.email == email);
      allow delete: if isAdmin();
    }

    // שארית ממבנה קודם, נמחקת אוטומטית בדף הניהול
    match /queue/{fileId} {
      allow read, delete: if isAdmin();
    }
  }
}
