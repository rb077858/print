rules_version = '2';

// כללי האבטחה של Firestore. יש להדביק את הקובץ הזה בקונסולת Firebase:
// Firestore Database -> Rules -> Publish
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && request.auth.token.email == 'rb077858@gmail.com'
        && request.auth.token.email_verified == true;
    }

    // קוד בתוקף: ttlMinutes == 0 פירושו "לא פג לעולם"
    function alive(c) {
      return c.ttlMinutes == 0
        || request.time < c.createdAt + duration.value(c.ttlMinutes, 'm');
    }

    // מי שמימש קוד מקבל "אישור" ל-10 דקות לקרוא את הקבצים של אותו קוד בלבד,
    // או (בקוד תור) את כל הקבצים שנמצאים כרגע בתור
    function claimOk(fileId) {
      let p = /databases/$(database)/documents/claims/$(request.auth.uid);
      return signedIn()
        && exists(p)
        && request.time < get(p).data.at + duration.value(10, 'm')
        && (fileId in get(p).data.fileIds
          || (get(p).data.queue == true && inQueue(fileId)));
    }

    // קובץ בתור = יש לו קוד חד-פעמי שעדיין לא נוצל ולא פג
    function inQueue(fileId) {
      let q = /databases/$(database)/documents/queue/$(fileId);
      return exists(q) && get(q).data.done == false && alive(get(q).data);
    }

    // הקוד מומש עכשיו, בכתיבה הזו, על ידי המשתמש הזה
    function usedNow(c) {
      return c.singleUse == true && c.used == true
        && c.usedBy == request.auth.uid && c.usedAt == request.time;
    }

    function validClaim(d) {
      let c = getAfter(/databases/$(database)/documents/codes/$(d.code)).data;
      return (
        (d.queue == true && c.mode == 'queue' && d.fileIds.size() == 0)
        || (d.queue == false && c.mode != 'queue' && d.fileIds == c.fileIds)
      ) && (usedNow(c) || (c.singleUse == false && alive(c)));
    }

    match /files/{fileId} {
      allow read: if isAdmin() || claimOk(fileId);
      // העלאה מדף /send (משתמש אנונימי)
      allow create: if isAdmin() || (signedIn()
        && request.resource.data.keys().hasOnly(['name', 'type', 'size', 'chunks', 'owner', 'createdAt', 'source'])
        && request.resource.data.owner == request.auth.uid
        && request.resource.data.source == 'send'
        && request.resource.data.createdAt == request.time
        && request.resource.data.size is int
        && request.resource.data.size <= 15 * 1024 * 1024
        && request.resource.data.chunks is int
        && request.resource.data.chunks >= 1
        && request.resource.data.chunks <= 25);
      allow update, delete: if isAdmin();

      match /chunks/{n} {
        allow read: if isAdmin() || claimOk(fileId);
        allow create: if isAdmin() || (signedIn()
          && get(/databases/$(database)/documents/files/$(fileId)).data.owner == request.auth.uid
          && int(n) < get(/databases/$(database)/documents/files/$(fileId)).data.chunks
          && request.resource.data.keys().hasOnly(['d'])
          && request.resource.data.d is bytes
          && request.resource.data.d.size() <= 800000);
        allow update, delete: if isAdmin();
      }
    }

    match /codes/{code} {
      // אפשר לבדוק קוד מסוים, אבל רק המנהל יכול לראות את רשימת כל הקודים
      allow get: if signedIn();
      allow list: if isAdmin();

      // קוד שנוצר מדף /send: 6 ספרות, חד-פעמי, שעתיים, לקובץ שהמשתמש עצמו העלה
      allow create: if isAdmin() || (signedIn()
        && code.matches('^[0-9]{6}$')
        && request.resource.data.keys().hasOnly(['fileIds', 'mode', 'singleUse', 'ttlMinutes', 'used', 'createdAt', 'createdBy'])
        && request.resource.data.mode == 'single'
        && request.resource.data.singleUse == true
        && request.resource.data.used == false
        && request.resource.data.ttlMinutes == 120
        && request.resource.data.createdAt == request.time
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.fileIds is list
        && request.resource.data.fileIds.size() == 1
        && get(/databases/$(database)/documents/files/$(request.resource.data.fileIds[0])).data.owner == request.auth.uid);

      // מימוש קוד חד-פעמי: רק סימון כמשומש, ורק אם עדיין לא נוצל ובתוקף
      allow update: if isAdmin() || (signedIn()
        && resource.data.singleUse == true
        && resource.data.used == false
        && alive(resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['used', 'usedBy', 'usedAt'])
        && request.resource.data.used == true
        && request.resource.data.usedBy == request.auth.uid
        && request.resource.data.usedAt == request.time);

      allow delete: if isAdmin();
    }

    // התור: מסמך לכל קובץ שיש לו קוד חד-פעמי פעיל. אין בו את הקוד עצמו.
    match /queue/{fileId} {
      allow read: if signedIn();
      // נוצר מדף /send יחד עם הקוד
      allow create: if isAdmin() || (signedIn()
        && request.resource.data.keys().hasOnly(['ttlMinutes', 'createdAt', 'done'])
        && request.resource.data.ttlMinutes == 120
        && request.resource.data.createdAt == request.time
        && request.resource.data.done == false
        && get(/databases/$(database)/documents/files/$(fileId)).data.owner == request.auth.uid);
      // יוצא מהתור כשהקוד שלו מומש
      allow update: if isAdmin() || (signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['done', 'usedCode'])
        && request.resource.data.done == true
        && request.resource.data.usedCode is string
        && usedNow(getAfter(/databases/$(database)/documents/codes/$(request.resource.data.usedCode)).data)
        && fileId in getAfter(/databases/$(database)/documents/codes/$(request.resource.data.usedCode)).data.fileIds);
      allow delete: if isAdmin();
    }

    match /claims/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['code', 'fileIds', 'at', 'queue'])
        && request.resource.data.code is string
        && request.resource.data.queue is bool
        && request.resource.data.at == request.time
        && validClaim(request.resource.data);
      allow delete: if isAdmin();
    }
  }
}
